{
	"workbench.colorTheme": "AK Jucebox",
	// Generated by "npm run themes" — palette fallback for machines without the AK theme pack
	"workbench.colorCustomizations": {
		"titleBar.activeBackground": "#8c5c11",
		"titleBar.activeForeground": "#ffffff",
		"titleBar.inactiveBackground": "#523a16",
		"titleBar.inactiveForeground": "#ffffff",
		"commandCenter.background": "#ffffff",
		"commandCenter.foreground": "#8c5c11",
		"commandCenter.activeBackground": "#ffffff",
		"commandCenter.activeForeground": "#8c5c11",
		"commandCenter.inactiveBackground": "#ffffff",
		"commandCenter.inactiveForeground": "#8c5c11",
		"commandCenter.border": "#8c5c1133",
		"commandCenter.activeBorder": "#8c5c1155",
		"commandCenter.inactiveBorder": "#8c5c1122",
		"activityBar.background": "#473417",
		"activityBar.activeBackground": "#634415",
		"activityBar.activeBorder": "#9a6410",
		"activityBar.activeFocusBorder": "#9a6410",
		"activityBarBadge.background": "#855812",
		"activityBarBadge.foreground": "#ffffff",
		"statusBar.background": "#734e13",
		"statusBarItem.remoteBackground": "#7c5213",
		"statusBarItem.remoteForeground": "#ffffff",
		"icon.foreground": "#fbf4e1",
		"focusBorder": "#ebc86a",
		"editorCursor.foreground": "#ebc86a",
		"progressBar.background": "#ebc86a",
		"quickInput.background": "#161719b3",
		"quickInput.foreground": "#ffffff",
		"quickInputList.focusForeground": "#ffffff",
		"quickInputList.focusIconForeground": "#ffffff",
		"pickerGroup.foreground": "#ebc86a",
		"activityBar.foreground": "#ffffff",
		"activityBar.inactiveForeground": "#ffffffb3",
		"statusBar.foreground": "#ffffffd9",
		"sideBar.foreground": "#ffffffd9",
		"sideBarTitle.foreground": "#ffffffd9",
		"sideBarSectionHeader.foreground": "#ffffffd9"
	},
	// GitHub Copilot auto-approval settings
	"chat.agent.maxRequests": 100,
	"github.copilot.chat.agent.runTasks": true,
	"chat.tools.autoApprove": true,
	"chat.editing.autoAcceptDelay": 100,
	// Terminal shell integration for improved command detection
	"terminal.integrated.shellIntegration.enabled": true,
	"terminal.integrated.shellIntegration.decorationsEnabled": "both",
	"cmake.configureOnOpen": true,
	"cmake.useCMakePresets": "always",
	"C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
	"files.associations": {
		"*.h": "cpp",
		"*.hpp": "cpp",
		"*.cpp": "cpp",
		"*.mm": "cpp"
	},
	"files.exclude": {
		"_deps/**": true
	},
	"cSpell.words": [
		"ALSA",
		"artefacts",
		"ASIO",
		"automatable",
		"autoremove",
		"biquad",
		"ccache",
		"chatmode",
		"chatmodes",
		"constexpr",
		"elif",
		"frontmatter",
		"jackd",
		"jassert",
		"JUCE",
		"ladspa",
		"libasound",
		"libfontconfig",
		"libfreetype",
		"libglu",
		"libjack",
		"libwebkit",
		"libx",
		"libxcomposite",
		"libxcursor",
		"libxext",
		"libxinerama",
		"libxrandr",
		"libxrender",
		"lldb",
		"Makefiles",
		"Metaprogramming",
		"msbuild",
		"MSVC",
		"noninteractive",
		"Nyquist",
		"oneline",
		"Projucer",
		"RAII",
		"Sheenbidi"
	],
	"[markdown]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "vscode.markdown-language-features",
		"editor.codeActionsOnSave": {
			"source.fixAll.markdownlint": "explicit"
		},
		"editor.wordWrap": "bounded",
		"editor.wordWrapColumn": 120
	},
	"[cpp]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "ms-vscode.cpptools"
	},
	"[c]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "ms-vscode.cpptools"
	},
	"[json]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"chat.tools.terminal.autoApprove": {
		"cd": true,
		"echo": true,
		"ls": true,
		"pwd": true,
		"cat": true,
		"head": true,
		"tail": true,
		"findstr": true,
		"wc": true,
		"tr": true,
		"cut": true,
		"cmp": true,
		"which": true,
		"basename": true,
		"dirname": true,
		"realpath": true,
		"readlink": true,
		"stat": true,
		"file": true,
		"du": true,
		"df": true,
		"sleep": true,
		"mkdir": true,
		"cmake": true,
		"ninja": true,
		"make": true,
		"npm": true,
		"node": true,
		"clang-format": true,
		"./scripts/build-ninja.sh": true,
		"./scripts/configure-ninja.sh": true,
		"./scripts/run-standalone.sh": true,
		"./scripts/validate-builds.sh": true,
		"./scripts/validate-setup.sh": true,
		"./scripts/format-cpp.sh": true,
		"./scripts/test-builds.sh": true,
		"source": true,
		"git status": true,
		"git log": true,
		"git show": true,
		"git diff": true,
		"Get-ChildItem": true,
		"Get-Content": true,
		"Get-Date": true,
		"Get-Random": true,
		"Get-Location": true,
		"Write-Host": true,
		"Write-Output": true,
		"Split-Path": true,
		"Join-Path": true,
		"Start-Sleep": true,
		"Where-Object": true,
		"/^Select-[a-z0-9]/i": true,
		"/^Measure-[a-z0-9]/i": true,
		"/^Compare-[a-z0-9]/i": true,
		"/^Format-[a-z0-9]/i": true,
		"/^Sort-[a-z0-9]/i": true,
		"column": true,
		"/^column\\b.*-c\\s+[0-9]{4,}/": false,
		"date": true,
		"/^date\\b.*(-s|--set)\\b/": false,
		"find": true,
		"/^find\\b.*-(delete|exec|execdir|fprint|fprintf|fls|ok|okdir)\\b/": false,
		"grep": true,
		"/^grep\\b.*-(f|P)\\b/": false,
		"sort": true,
		"/^sort\\b.*-(o|S)\\b/": false,
		"tree": true,
		"/^tree\\b.*-o\\b/": false,
		"/\\(.+\\)/": {
			"approve": false,
			"matchCommandLine": true
		},
		"/\\{.+\\}/": {
			"approve": false,
			"matchCommandLine": true
		},
		"/`.+`/": {
			"approve": false,
			"matchCommandLine": true
		},
		"rm": false,
		"rmdir": false,
		"del": false,
		"Remove-Item": false,
		"ri": false,
		"rd": false,
		"erase": false,
		"dd": false,
		"kill": false,
		"ps": false,
		"top": false,
		"Stop-Process": false,
		"spps": false,
		"taskkill": false,
		"taskkill.exe": false,
		"curl": false,
		"wget": false,
		"Invoke-RestMethod": false,
		"Invoke-WebRequest": false,
		"irm": false,
		"iwr": false,
		"chmod": false,
		"chown": false,
		"Set-ItemProperty": false,
		"sp": false,
		"Set-Acl": false,
		"jq": false,
		"xargs": false,
		"eval": false,
		"Invoke-Expression": false,
		"iex": false
	}
}
