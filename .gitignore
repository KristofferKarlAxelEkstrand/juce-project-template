# JUCE framework and external dependencies
JUCE/
_deps/
**/JUCE/
**/_deps/
# Keep the vendored JUCE submodule tracked.
!third_party/JUCE/
!third_party/JUCE/**
!docs/JUCE/

# Local development configuration
.devcontainer/.env

# Build directory (root-anchored to avoid hiding source under scripts/build/)
/build/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt
!cmake/*.cmake
!cmake/**/*.cmake

# Visual Studio project files
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates
*.pdb

# Compiled binaries
*.exe
*.dll
*.lib
*.a
*.so
*.dylib

# JUCE generated files
**/JuceLibraryCode/
**/*_artefacts/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs and temp files
*.tmp
*.temp
*.log

# PR review temp documents
.temp-pr-reviews-docs/

# Plugin builds
*.vst3
*.au
*.aax

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor backups
*~
*.bak
*.swp
*.swo
